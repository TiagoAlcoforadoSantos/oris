# ==========================================================
# ORIS - Exemplo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA versionar o arquivo ".env" real (ele contém segredos).
# ==========================================================

# Ambiente da aplicação: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=True

# Chave secreta usada pelo Flask para assinar sessões/cookies.
# Gere uma chave forte, por exemplo com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte

# ----------------------------------------------------------
# Configuração do banco de dados MySQL
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oris_db
DB_USER=oris_user
DB_PASSWORD=troque-esta-senha

# ----------------------------------------------------------
# Configuração de sessão
# ----------------------------------------------------------
# Tempo de expiração da sessão, em minutos
SESSION_LIFETIME_MINUTES=60

# ----------------------------------------------------------
# Fase 14 - Requisito 3: usuarios/grupos via LDAP e OIDC
# ----------------------------------------------------------
# Mapa grupo do diretorio -> perfil RBAC do ORIS (JSON). Sem mapa nenhum
# usuario externo e provisionado. Maior privilegio vence.
DIRETORIO_MAPA_GRUPO_PERFIL={"oris-admin":"ADMINISTRADOR","oris-gestao":"GESTAO_INFORMACAO","oris-saude":"RESPONSAVEL_SAUDE_BUCAL","oris-gestor":"GESTOR"}

# LDAP (use ldaps:// ou LDAP_USE_STARTTLS=true; senha de bind vem do ambiente)
LDAP_URI=
LDAP_USE_STARTTLS=false
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
LDAP_GROUP_BASE=

# OIDC (Authorization Code + PKCE). Issuer precisa ser https://
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLAIM_GROUPS=groups

# ----------------------------------------------------------
# Fase 14 - Requisito 4: exportacao de relatorios para o Amazon S3
# ----------------------------------------------------------
# As credenciais AWS NAO ficam aqui: o boto3 usa a cadeia padrao
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, ~/.aws ou IAM Role).
S3_BUCKET=
S3_REGION=
S3_PREFIX=oris/relatorios
S3_URL_EXPIRA_SEGUNDOS=900
